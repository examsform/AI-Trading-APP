# Personal V1 — Angel One is the only broker. Market data + broker account access both
# come through the official Angel One SmartAPI once connected.
MARKET_DATA_PROVIDER=mock
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_ID=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# Supabase (Auth + Postgres) — private owner access only, no public signup in Personal V1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider — needed once mockSignalEngine is replaced with a real model call.
AI_PROVIDER=
ANTHROPIC_API_KEY=

DEMO_INITIAL_CAPITAL=1000000
